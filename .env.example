# Mailjet (https://app.mailjet.com/account/apikeys) — free tier: 200 emails/day
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Sender identity for outgoing contact-form emails
EMAIL_FROM_ADDRESS=info@s3globe.in
EMAIL_FROM_NAME=S3 Globe Web Solutions

# Inbox that receives contact-form submissions (defaults to EMAIL_FROM_ADDRESS if unset)
CONTACT_TO_ADDRESS=info@s3globe.in
