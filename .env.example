# Upstash Redis (https://console.upstash.com) — free tier, backs the site
# visit counter. Create a database, copy the REST API URL/Token from its
# dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Note: the contact form's Web3Forms access key is intentionally NOT a
# server env var — Web3Forms is called directly from the browser (see
# src/app/pages/contact/contact.ts), and its access key is meant to be
# public client-side, protected by Web3Forms's own domain-restriction
# setting rather than secrecy.
